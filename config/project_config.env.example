# ==============================================================================
# 3-Project Enterprise A2A Governance Configuration (Argolis)
# ==============================================================================
# Copy this file to `config/project_config.env` and populate your Argolis values:
#   cp config/project_config.env.example config/project_config.env
# Then run:
#   ./scripts/bootstrap_tf.sh
# ==============================================================================

# Argolis Organization ID (numeric)
ORG_ID="123456789012"

# Primary GCP Region for Vertex AI Agent Runtime, Agent Gateway & Agent Registry
REGION="us-central1"

# Project 3: Central Governance & Agent Gateway Host Project ID
GATEWAY_PROJECT_ID="argolis-agw-gov-proj"

# Project 1: Coordinator Agent A Host Project ID
AGENT_A_PROJECT_ID="argolis-agent-a-proj"

# Project 2: Specialist Agent B Host Project ID
AGENT_B_PROJECT_ID="argolis-agent-b-proj"

# Organization-level Access Context Manager (VPC-SC) Policy ID (numeric)
# Leave empty if you want bootstrap_tf.sh to auto-detect the org's default policy
VPC_SC_POLICY_ID="987654321"

# IAM Principal granted administrative access inside the VPC-SC Access Level
VPC_SC_ADMIN_USER="user:admin@your-argolis-domain.com"

# Default Gemini model used by both ADK agents
GEMINI_MODEL="gemini-3.5-flash"

# Logical Agent B Identifier registered in Project 3's Central Agent Registry
REMOTE_AGENT_B_ID="agents/specialist-agent-b"
